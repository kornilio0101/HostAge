#include <windows.h>
#include "resource.h"

// Application Icon
IDI_APP_ICON ICON "resources\\app.ico"

// RT_MANIFEST = 24
1 24 "resources\\app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Hostage Team\0"
            VALUE "FileDescription",  "Hostage - Windows Hosts File Manager\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "Hostage\0"
            VALUE "LegalCopyright",   "Open Source (MIT)\0"
            VALUE "OriginalFilename", "Hostage.exe\0"
            VALUE "ProductName",      "Hostage Hosts Manager\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
